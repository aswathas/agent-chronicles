---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import "../styles/chronicles.css";

const mcodePlugins = [
  {
    name: "aswath-token-guard",
    role: "Context Window Guard Hook",
    focus: "Pre/post command hook intercepting verbose stdout via rtk, enforcing read-once file discipline, and maintaining live session ledger.",
  },
  {
    name: "aswath-compact",
    role: "Trajectory Distiller & Headroom Reset",
    focus: "Distils multi-turn trajectories to dense handoff state and releases the context window when ledger passes 200k tokens.",
  },
  {
    name: "aswath-skill-router",
    role: "Adaptive Feedback Learning Hook",
    focus: "Learns from what actually happens in session (user edits, corrections, deletes) and tunes routing weights dynamically.",
  },
  {
    name: "aswath-forge",
    role: "Pre-Execution Catalog Gate",
    focus: "Halts ungrounded coding loops and enforces searching ~/.minimax/skills before creating or modifying files.",
  },
  {
    name: "aswath-first-principles",
    role: "10-Point Spec Gatekeeper",
    focus: "Decide before build: strict user approval gate before scaffolding, manifests, or implementation stubs.",
  },
  {
    name: "doubt-driven-development",
    role: "Fresh-Context Adversarial Review",
    focus: "Subagent cross-examination testing for race conditions, timeouts, and hidden failure modes before code merges.",
  },
];
---

<Base
  title="Workflows & MCode Plugins — The Agent Chronicles"
  description="MiniMax Code (mcode) plugins, lifecycle hooks, doubt-driven review loops, and prompt compression systems."
>
  <Nav currentPath="/workflows/" />

  <main class="s page-container">
    <header class="page-header">
      <div class="eyebrow">AGENT LIFECYCLE HOOKS · MCODE PLUGINS · VERIFICATION LOOPS</div>
      <h1 class="page-title">Workflows &amp; MCode Plugins</h1>
      <p class="page-lede">
        Custom plugins, lifecycle hooks, and verification loops engineered inside MiniMax Code (<code>mcode</code>) to eliminate token waste, ungrounded code generation, and repeated routing mistakes.
      </p>
    </header>

    <!-- Workflow 1: MiniMax Code Plugin Architecture -->
    <section class="wf-section">
      <div class="wf-badge">MCODE PLUGIN SUITE · PUBLISHED</div>
      <h2>MiniMax Code (mcode) Lifecycle Plugins</h2>
      <p class="wf-desc">
        Traditional agents rely on monolithic system prompts that burn permanent tokens on every turn. Our custom <code>mcode</code> plugins run as <b>lightweight lifecycle hooks</b> in the MiniMax Code engine (`~/.minimax/plugins/`), intercepting commands, auditing context spend, and adapting routing weights in real time.
      </p>

      <div class="persona-grid">
        {mcodePlugins.map((p) => (
          <div class="persona-card">
            <span class="p-name">{p.name}</span>
            <b class="p-role">{p.role}</b>
            <p class="p-focus">{p.focus}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Workflow 2: Doubt-Driven Development -->
    <section class="wf-section">
      <div class="wf-badge">VERIFICATION LOOP</div>
      <h2>Doubt-Driven Development</h2>
      <p class="wf-desc">
        Subjects every non-trivial decision to a fresh-context adversarial review before code or config is written. Used when correctness matters more than speed: production authentication, schema migrations, and irreversible system operations.
      </p>
      <div class="loop-steps">
        <div class="step">
          <span class="step-num">STEP 1</span>
          <b>Hypothesis &amp; Plan</b>
          <p>Agent drafts proposed implementation spec.</p>
        </div>
        <div class="step-arrow">➔</div>
        <div class="step alert">
          <span class="step-num">STEP 2</span>
          <b>Adversarial Cross-Exam</b>
          <p>Fresh subagent attacks assumptions &amp; hidden failures.</p>
        </div>
        <div class="step-arrow">➔</div>
        <div class="step">
          <span class="step-num">STEP 3</span>
          <b>Hardened Spec</b>
          <p>Contradictions resolved before code is written.</p>
        </div>
      </div>
    </section>

    <!-- Workflow 3: Prompt Library & Compression -->
    <section class="wf-section">
      <div class="wf-badge">PROMPT COMPRESSION &amp; RULES</div>
      <h2>Prompt Library &amp; Token Guardrails</h2>
      <p class="wf-desc">
        Rules and system prompts that strip conversational ceremony, enforce read-once discipline, and compress responses to pure signal.
      </p>

      <div class="prompts-grid">
        <div class="prompt-card">
          <h3>aswath-talk / ponytail</h3>
          <span class="p-rule">Compression Rule</span>
          <p>Combines caveman brevity with ponytail minimalism. Bans fluff words ("delighted to", "game-changer", "let's dive in") in favor of short sentences, plain words, and the smallest thing that actually works.</p>
        </div>
        <div class="prompt-card">
          <h3>Token Guard Hooks</h3>
          <span class="p-rule">Lifecycle Hook</span>
          <p>Enforces read-once file rules: never re-read an unchanged file region. Intercepts terminal commands with rtk folding and triggers automated session compaction before context passes 200k tokens.</p>
        </div>
        <div class="prompt-card">
          <h3>LinkedIn Humanizer Gate</h3>
          <span class="p-rule">Gate Tool</span>
          <p>Automated verification script checking post drafts against 24 banned AI tropes, enforcing sentence distribution, and validating code and test proof citations.</p>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Base>

<style>
  .page-container {
    padding-top: 48px;
    padding-bottom: 96px;
  }
  .page-header {
    margin-bottom: 48px;
    border-bottom: 3px double var(--ink);
    padding-bottom: 24px;
  }
  .eyebrow {
    font-family: "IBM Plex Mono", monospace;
    font-size: 11px;
    letter-spacing: 0.16em;
    color: var(--red);
    text-transform: uppercase;
    margin-bottom: 8px;
  }
  .page-title {
    font-family: "Archivo Black", sans-serif;
    font-size: 2.8rem;
    line-height: 1;
    text-transform: uppercase;
    letter-spacing: -0.03em;
    margin-bottom: 16px;
  }
  .page-lede {
    font-size: 1.25rem;
    color: var(--grey);
    line-height: 1.5;
    max-width: 860px;
  }

  .wf-section {
    margin-bottom: 80px;
    border-top: 1px solid var(--ink);
    padding-top: 36px;
  }
  .wf-badge {
    font-family: "IBM Plex Mono", monospace;
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--red);
    margin-bottom: 8px;
  }
  .wf-section h2 {
    font-family: "Archivo Black", sans-serif;
    font-size: 2rem;
    text-transform: uppercase;
    letter-spacing: -0.02em;
    margin-bottom: 16px;
  }
  .wf-desc {
    font-size: 1.2rem;
    color: var(--grey);
    line-height: 1.5;
    max-width: 860px;
    margin-bottom: 32px;
  }

  .persona-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }
  .persona-card {
    background: var(--card);
    border: 2px solid var(--ink);
    padding: 20px;
    box-shadow: 4px 4px 0 var(--ink);
  }
  .p-name {
    display: block;
    font-family: "IBM Plex Mono", monospace;
    font-size: 12px;
    color: var(--blue);
    font-weight: bold;
    margin-bottom: 6px;
  }
  .p-role {
    display: block;
    font-family: "Archivo Black", sans-serif;
    font-size: 1rem;
    text-transform: uppercase;
    margin-bottom: 8px;
    color: var(--ink);
  }
  .p-focus {
    font-size: 14px;
    color: var(--grey);
    line-height: 1.45;
  }

  .loop-steps {
    display: flex;
    align-items: center;
    gap: 16px;
    background: var(--card);
    border: 2px solid var(--ink);
    padding: 32px;
    box-shadow: 6px 6px 0 var(--ink);
    flex-wrap: wrap;
  }
  .step {
    flex: 1;
    min-width: 180px;
    background: var(--paper);
    border: 1px solid var(--ink);
    padding: 16px;
  }
  .step.alert {
    background: #fff5f5;
    border-color: #ef4444;
  }
  .step-num {
    display: block;
    font-family: "IBM Plex Mono", monospace;
    font-size: 10px;
    letter-spacing: 0.1em;
    color: var(--grey);
    margin-bottom: 4px;
  }
  .step b {
    display: block;
    font-family: "Archivo Black", sans-serif;
    font-size: 1.1rem;
    text-transform: uppercase;
    margin-bottom: 8px;
  }
  .step p {
    font-size: 13px;
    color: var(--grey);
    line-height: 1.4;
  }
  .step-arrow {
    font-size: 20px;
    color: var(--ink);
    font-weight: bold;
  }

  .prompts-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }
  .prompt-card {
    background: var(--card);
    border: 2px solid var(--ink);
    padding: 24px;
    box-shadow: 4px 4px 0 var(--ink);
  }
  .prompt-card h3 {
    font-family: "Archivo Black", sans-serif;
    font-size: 1.2rem;
    text-transform: uppercase;
    margin-bottom: 6px;
  }
  .p-rule {
    display: inline-block;
    font-family: "IBM Plex Mono", monospace;
    font-size: 10px;
    letter-spacing: 0.1em;
    background: var(--paper2);
    border: 1px solid var(--ink);
    padding: 2px 8px;
    text-transform: uppercase;
    margin-bottom: 12px;
  }
  .prompt-card p {
    font-size: 14px;
    color: var(--grey);
    line-height: 1.5;
  }

  @media (max-width: 900px) {
    .persona-grid, .prompts-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
