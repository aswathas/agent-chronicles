---
import Base from "../../layouts/Base.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import "../../styles/chronicles.css";
import catalog from "../../data/catalog.json";

export function getStaticPaths() {
  return catalog.map((item) => ({
    params: { slug: item.slug },
    props: { item },
  }));
}

const { item } = Astro.props;
const rawBase = import.meta.env.BASE_URL || "/";
const base = rawBase.endsWith("/") ? rawBase : `${rawBase}/`;
---

<Base
  title={`${item.name} — Tool Specification & Benchmarks | The Agent Chronicles`}
  description={item.tagline}
>
  <Nav currentPath="/code-mode/" />

  <main class="s page-container">
    <!-- Breadcrumbs -->
    <nav class="breadcrumb-nav">
      <a href={base}>Home</a>
      <span class="sep">/</span>
      <a href={`${base}code-mode/`}>Code Mode &amp; MCP</a>
      <span class="sep">/</span>
      <span class="current">{item.name}</span>
    </nav>

    <!-- Hero Header -->
    <header class="detail-header">
      <div class="header-badges">
        <span class="category-badge">{item.category}</span>
        <span class="status-badge">{item.badge}</span>
      </div>
      <div class="eyebrow">{item.eyebrow}</div>
      <h1 class="item-title">{item.name}</h1>
      <p class="item-tagline">{item.tagline}</p>
    </header>

    <!-- Primary One-Line Install Card -->
    <section class="install-hero-card">
      <div class="install-bar-header">
        <div class="install-label">
          <span class="terminal-dot red"></span>
          <span class="terminal-dot yellow"></span>
          <span class="terminal-dot green"></span>
          <span class="bar-title">ONE-LINE INSTALLATION</span>
        </div>
        <span class="copy-hint">Click box to copy</span>
      </div>
      <div class="install-code-row" id="primaryInstallBox" data-copy={item.installCommand}>
        <span class="prompt-symbol">$</span>
        <code class="install-text">{item.installCommand}</code>
        <button class="copy-action-btn" aria-label="Copy installation command">
          <span class="btn-text">COPY</span>
        </button>
      </div>
      {item.cliCommand && (
        <div class="secondary-command-row">
          <span class="sec-label">CLI Runner:</span>
          <code class="sec-code copyable" data-copy={item.cliCommand}>{item.cliCommand}</code>
        </div>
      )}
    </section>

    <!-- Visual Architecture / Diagram / Animation -->
    <section class="diagram-section">
      <div class="section-microhead">
        <span class="section-tag">ARCHITECTURE &amp; INTERACTIVE FLOW</span>
        <h2>System Dataflow &amp; Runtime Diagram</h2>
      </div>
      <div class="diagram-viewport">
        <Fragment set:html={item.diagramSvg} />
      </div>
    </section>

    <!-- Model Card & Specification Sheet -->
    <section class="model-card-section">
      <div class="section-microhead">
        <span class="section-tag">SPECIFICATION SHEET</span>
        <h2>Model / Capability Card</h2>
      </div>
      <div class="spec-grid">
        <div class="spec-tile">
          <div class="spec-lbl">Runtime Environment</div>
          <div class="spec-val font-mono">{item.modelCard.runtime}</div>
        </div>
        <div class="spec-tile">
          <div class="spec-lbl">Capability Architecture</div>
          <div class="spec-val">{item.modelCard.type}</div>
        </div>
        <div class="spec-tile">
          <div class="spec-lbl">Transport Protocol</div>
          <div class="spec-val font-mono">{item.modelCard.transport}</div>
        </div>
        <div class="spec-tile highlight">
          <div class="spec-lbl">Context Tax Footprint</div>
          <div class="spec-val font-mono highlight-green">{item.modelCard.contextTax}</div>
        </div>
        <div class="spec-tile">
          <div class="spec-lbl">Test &amp; Benchmark Pass</div>
          <div class="spec-val font-mono highlight-blue">{item.modelCard.testCoverage}</div>
        </div>
        <div class="spec-tile">
          <div class="spec-lbl">License</div>
          <div class="spec-val font-mono">{item.modelCard.license}</div>
        </div>
      </div>
      {item.modelCard.dependencies.length > 0 && (
        <div class="deps-row">
          <span class="deps-label">Dependencies:</span>
          <div class="deps-tags">
            {item.modelCard.dependencies.map((dep) => (
              <span class="dep-pill">{dep}</span>
            ))}
          </div>
        </div>
      )}
    </section>

    <!-- Problem & Solution Section -->
    <section class="problem-solution-section">
      <div class="problem-box">
        <div class="box-tag tag-problem">THE FAILURE MODE SOLVED</div>
        <h3>The Concrete Engineering Problem</h3>
        <p>{item.problem}</p>
      </div>

      <div class="solution-box">
        <div class="box-tag tag-solution">THE ARCHITECTURE</div>
        <h3>The Engineered Solution</h3>
        <p>{item.solution}</p>
      </div>
    </section>

    <!-- Trigger Condition Card -->
    <div class="trigger-banner">
      <div class="trigger-icon">⚡</div>
      <div class="trigger-content">
        <span class="trigger-lbl">AGENT INVOCATION TRIGGER</span>
        <p class="trigger-desc">{item.trigger}</p>
      </div>
    </div>

    <!-- Evaluations & Proof Metrics Section -->
    <section class="eval-section">
      <div class="section-microhead">
        <span class="section-tag">BENCHMARKS &amp; PROOF</span>
        <h2>Evaluations &amp; Comparative Verification</h2>
      </div>

      <div class="headline-metric-card">
        <div class="big-metric-wrap">
          <span class="big-number">{item.evaluation.headlineMetric}</span>
          <span class="big-label">{item.evaluation.headlineSub}</span>
        </div>
        <div class="metric-explainer">
          <p>{item.evaluation.proofText}</p>
          <div class="verification-box">
            <span class="v-label">Reproducible Test Command:</span>
            <code class="copyable" data-copy={item.evaluation.verificationCmd}>{item.evaluation.verificationCmd}</code>
          </div>
        </div>
      </div>

      <!-- Comparative Table -->
      <div class="table-container">
        <table class="eval-table">
          <thead>
            <tr>
              <th>Evaluation Dimension</th>
              <th>Traditional Baseline / Standard MCP</th>
              <th>Our Engineered Solution</th>
              <th>Measured Delta</th>
            </tr>
          </thead>
          <tbody>
            {item.evaluation.comparisonTable.map((row) => (
              <tr>
                <td class="dim-name"><b>{row.metric}</b></td>
                <td class="trad-val">{row.traditional}</td>
                <td class="our-val">{row.proposed}</td>
                <td class="delta-val"><span class="delta-pill">{row.delta}</span></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- Code Example / Live Usage -->
    <section class="code-example-section">
      <div class="section-microhead">
        <span class="section-tag">IMPLEMENTATION EXAMPLE</span>
        <h2>{item.codeExample.title}</h2>
      </div>

      <div class="code-terminal">
        <div class="terminal-bar">
          <span class="term-title">Runtime Snippet ({item.codeExample.language})</span>
          <button class="term-copy-btn" id="copySnippetBtn" data-copy={item.codeExample.code}>
            Copy Code
          </button>
        </div>
        <pre class="terminal-pre"><code>{item.codeExample.code}</code></pre>
        <div class="terminal-output-bar">
          <span class="out-label">Expected Output:</span>
          <span class="out-val">{item.codeExample.output}</span>
        </div>
      </div>
    </section>

    <!-- Repository Action Bar -->
    <section class="repo-action-section">
      <div class="repo-action-card">
        <div class="repo-info">
          <h3>Explore Source Code &amp; Release History</h3>
          <p>Read the open-source implementation, commit ledger, and test harness on GitHub.</p>
        </div>
        <a href={item.repoUrl} target="_blank" rel="noopener" class="repo-btn">
          View on GitHub ➔
        </a>
      </div>
    </section>
  </main>

  <Footer />

  <script>
    function setupCopy(selector: string) {
      document.querySelectorAll<HTMLElement>(selector).forEach((el) => {
        el.addEventListener("click", () => {
          const text = el.dataset.copy || el.textContent || "";
          navigator.clipboard.writeText(text.trim()).then(() => {
            const btn = el.querySelector(".btn-text") as HTMLElement || el;
            const prevText = btn.textContent;
            btn.textContent = "✔ COPIED!";
            setTimeout(() => {
              btn.textContent = prevText;
            }, 1800);
          });
        });
      });
    }

    setupCopy("#primaryInstallBox");
    setupCopy(".copyable");
    setupCopy("#copySnippetBtn");
  </script>
</Base>

<style>
  .page-container {
    padding-top: 36px;
    padding-bottom: 96px;
  }

  .breadcrumb-nav {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: "IBM Plex Mono", monospace;
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--grey);
    margin-bottom: 28px;
  }
  .breadcrumb-nav a {
    color: var(--ink);
    text-decoration: none;
    border-bottom: 1px dotted var(--grey);
  }
  .breadcrumb-nav a:hover {
    color: var(--red);
    border-color: var(--red);
  }
  .breadcrumb-nav .sep {
    color: var(--grey);
    opacity: 0.5;
  }
  .breadcrumb-nav .current {
    color: var(--red);
    font-weight: 500;
  }

  .detail-header {
    margin-bottom: 36px;
    border-bottom: 3px double var(--ink);
    padding-bottom: 24px;
  }
  .header-badges {
    display: flex;
    gap: 12px;
    margin-bottom: 14px;
    flex-wrap: wrap;
  }
  .category-badge {
    font-family: "IBM Plex Mono", monospace;
    font-size: 11px;
    letter-spacing: 0.1em;
    background: var(--paper2);
    color: var(--ink);
    padding: 3px 10px;
    border: 1px solid var(--ink);
    border-radius: 999px;
    text-transform: uppercase;
  }
  .status-badge {
    font-family: "IBM Plex Mono", monospace;
    font-size: 11px;
    letter-spacing: 0.1em;
    background: #022c22;
    color: #6ee7b7;
    padding: 3px 10px;
    border: 1px solid #059669;
    border-radius: 999px;
    text-transform: uppercase;
  }
  .eyebrow {
    font-family: "IBM Plex Mono", monospace;
    font-size: 11px;
    letter-spacing: 0.16em;
    color: var(--red);
    text-transform: uppercase;
    margin-bottom: 8px;
  }
  .item-title {
    font-family: "Archivo Black", sans-serif;
    font-size: 3.2rem;
    line-height: 1;
    text-transform: uppercase;
    letter-spacing: -0.03em;
    margin-bottom: 16px;
    word-break: break-word;
  }
  .item-tagline {
    font-size: 1.35rem;
    color: var(--grey);
    line-height: 1.45;
    max-width: 900px;
  }

  /* One-Line Install Card */
  .install-hero-card {
    background: #0c121e;
    color: #e2e8f0;
    border: 2px solid var(--ink);
    border-radius: 8px;
    box-shadow: 6px 6px 0 var(--ink);
    padding: 20px 24px;
    margin-bottom: 48px;
  }
  .install-bar-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 14px;
    border-bottom: 1px solid #1e293b;
    padding-bottom: 10px;
  }
  .install-label {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .terminal-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }
  .terminal-dot.red { background: #ef4444; }
  .terminal-dot.yellow { background: #f59e0b; }
  .terminal-dot.green { background: #10b981; }
  .bar-title {
    font-family: "IBM Plex Mono", monospace;
    font-size: 11px;
    letter-spacing: 0.14em;
    color: #94a3b8;
    margin-left: 6px;
  }
  .copy-hint {
    font-family: "IBM Plex Mono", monospace;
    font-size: 11px;
    color: #64748b;
  }
  .install-code-row {
    display: flex;
    align-items: center;
    gap: 12px;
    background: #020617;
    border: 1px solid #334155;
    border-radius: 6px;
    padding: 14px 18px;
    cursor: pointer;
    transition: border-color 0.15s, background 0.15s;
  }
  .install-code-row:hover {
    border-color: #38bdf8;
    background: #090e1a;
  }
  .prompt-symbol {
    font-family: "IBM Plex Mono", monospace;
    color: #10b981;
    font-weight: 700;
    user-select: none;
  }
  .install-text {
    flex: 1;
    font-family: "IBM Plex Mono", monospace;
    font-size: 15px;
    color: #38bdf8;
    overflow-x: auto;
    white-space: nowrap;
  }
  .copy-action-btn {
    background: #1e293b;
    border: 1px solid #475569;
    color: #f8fafc;
    font-family: "IBM Plex Mono", monospace;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.1em;
    padding: 6px 14px;
    border-radius: 4px;
    cursor: pointer;
    transition: all 0.15s ease;
  }
  .copy-action-btn:hover {
    background: #38bdf8;
    color: #020617;
    border-color: #38bdf8;
  }
  .secondary-command-row {
    margin-top: 14px;
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 13px;
    flex-wrap: wrap;
  }
  .sec-label {
    font-family: "IBM Plex Mono", monospace;
    font-size: 11px;
    color: #94a3b8;
    text-transform: uppercase;
  }
  .sec-code {
    background: #151d2f;
    border: 1px solid #334155;
    padding: 4px 10px;
    border-radius: 4px;
    font-family: "IBM Plex Mono", monospace;
    color: #a7f3d0;
    cursor: pointer;
    font-size: 13px;
  }
  .sec-code:hover {
    border-color: #34d399;
  }

  .section-microhead {
    margin-bottom: 20px;
  }
  .section-tag {
    font-family: "IBM Plex Mono", monospace;
    font-size: 11px;
    letter-spacing: 0.15em;
    color: var(--red);
    text-transform: uppercase;
    display: block;
    margin-bottom: 6px;
  }
  .section-microhead h2 {
    font-family: "Archivo Black", sans-serif;
    font-size: 1.8rem;
    line-height: 1.1;
    text-transform: uppercase;
    letter-spacing: -0.02em;
  }

  .diagram-section {
    margin-bottom: 56px;
  }
  .diagram-viewport {
    background: #0c121e;
    border: 2px solid var(--ink);
    border-radius: 8px;
    padding: 24px;
    box-shadow: 4px 4px 0 var(--ink);
    overflow-x: auto;
  }
  .diagram-viewport svg {
    display: block;
    width: 100%;
    max-width: 800px;
    margin: 0 auto;
    height: auto;
  }

  .model-card-section {
    margin-bottom: 56px;
    background: var(--card);
    border: 2px solid var(--ink);
    border-radius: 8px;
    padding: 28px;
    box-shadow: 4px 4px 0 var(--ink);
  }
  .spec-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 16px;
    margin-bottom: 24px;
  }
  .spec-tile {
    background: var(--paper);
    border: 1px solid var(--paper2);
    border-left: 3px solid var(--ink);
    padding: 14px 18px;
  }
  .spec-tile.highlight {
    border-left-color: #059669;
    background: #f0fdf4;
  }
  .spec-lbl {
    font-family: "IBM Plex Mono", monospace;
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--grey);
    margin-bottom: 6px;
  }
  .spec-val {
    font-size: 16px;
    color: var(--ink);
    font-weight: 500;
  }
  .font-mono {
    font-family: "IBM Plex Mono", monospace;
  }
  .highlight-green {
    color: #047857;
    font-weight: 700;
  }
  .highlight-blue {
    color: var(--blue);
    font-weight: 700;
  }
  .deps-row {
    display: flex;
    align-items: center;
    gap: 12px;
    border-top: 1px dashed var(--paper2);
    padding-top: 16px;
    flex-wrap: wrap;
  }
  .deps-label {
    font-family: "IBM Plex Mono", monospace;
    font-size: 11px;
    text-transform: uppercase;
    color: var(--grey);
  }
  .deps-tags {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }
  .dep-pill {
    background: var(--paper2);
    font-family: "IBM Plex Mono", monospace;
    font-size: 12px;
    padding: 2px 8px;
    border-radius: 4px;
    border: 1px solid var(--grey);
  }

  .problem-solution-section {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    margin-bottom: 36px;
  }
  .problem-box, .solution-box {
    padding: 28px;
    border: 2px solid var(--ink);
    border-radius: 8px;
    box-shadow: 4px 4px 0 var(--ink);
  }
  .problem-box {
    background: #fff5f5;
  }
  .solution-box {
    background: #f0fdf4;
  }
  .box-tag {
    font-family: "IBM Plex Mono", monospace;
    font-size: 11px;
    letter-spacing: 0.14em;
    font-weight: 700;
    margin-bottom: 12px;
  }
  .tag-problem { color: #dc2626; }
  .tag-solution { color: #059669; }
  .problem-box h3, .solution-box h3 {
    font-family: "Archivo Black", sans-serif;
    font-size: 1.4rem;
    line-height: 1.2;
    margin-bottom: 12px;
    text-transform: uppercase;
  }
  .problem-box p, .solution-box p {
    font-size: 1.15rem;
    line-height: 1.5;
    color: var(--ink);
  }

  .trigger-banner {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    background: var(--card);
    border: 2px solid var(--ink);
    border-left: 6px solid #f59e0b;
    border-radius: 6px;
    padding: 20px 24px;
    margin-bottom: 56px;
    box-shadow: 4px 4px 0 var(--ink);
  }
  .trigger-icon {
    font-size: 24px;
  }
  .trigger-lbl {
    font-family: "IBM Plex Mono", monospace;
    font-size: 11px;
    letter-spacing: 0.14em;
    color: #d97706;
    font-weight: 700;
    display: block;
    margin-bottom: 4px;
  }
  .trigger-desc {
    font-size: 1.15rem;
    color: var(--ink);
    line-height: 1.4;
  }

  .eval-section {
    margin-bottom: 56px;
  }
  .headline-metric-card {
    background: #0c121e;
    color: #e2e8f0;
    border: 2px solid var(--ink);
    border-radius: 8px;
    padding: 28px;
    box-shadow: 4px 4px 0 var(--ink);
    display: grid;
    grid-template-columns: 240px 1fr;
    gap: 32px;
    align-items: center;
    margin-bottom: 24px;
  }
  .big-metric-wrap {
    text-align: center;
    border-right: 1px solid #1e293b;
    padding-right: 24px;
  }
  .big-number {
    display: block;
    font-family: "Archivo Black", sans-serif;
    font-size: 3.8rem;
    color: #10b981;
    line-height: 1;
    margin-bottom: 6px;
  }
  .big-label {
    font-family: "IBM Plex Mono", monospace;
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #94a3b8;
  }
  .metric-explainer p {
    font-size: 1.15rem;
    line-height: 1.5;
    color: #cbd5e1;
    margin-bottom: 16px;
  }
  .verification-box {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    background: #020617;
    border: 1px solid #334155;
    padding: 10px 14px;
    border-radius: 4px;
  }
  .v-label {
    font-family: "IBM Plex Mono", monospace;
    font-size: 11px;
    letter-spacing: 0.1em;
    color: #94a3b8;
    text-transform: uppercase;
  }
  .verification-box code {
    font-family: "IBM Plex Mono", monospace;
    color: #38bdf8;
    cursor: pointer;
  }

  .table-container {
    background: var(--card);
    border: 2px solid var(--ink);
    border-radius: 8px;
    overflow-x: auto;
    box-shadow: 4px 4px 0 var(--ink);
  }
  .eval-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 15px;
    text-align: left;
  }
  .eval-table th {
    background: var(--paper2);
    font-family: "IBM Plex Mono", monospace;
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 14px 18px;
    border-bottom: 2px solid var(--ink);
  }
  .eval-table td {
    padding: 16px 18px;
    border-bottom: 1px solid var(--paper2);
    vertical-align: middle;
  }
  .dim-name {
    font-family: "IBM Plex Mono", monospace;
    font-size: 13px;
  }
  .trad-val {
    color: #b91c1c;
  }
  .our-val {
    color: #047857;
    font-weight: 500;
  }
  .delta-pill {
    background: #022c22;
    color: #6ee7b7;
    border: 1px solid #059669;
    font-family: "IBM Plex Mono", monospace;
    font-size: 11px;
    font-weight: 700;
    padding: 3px 8px;
    border-radius: 999px;
  }

  .code-example-section {
    margin-bottom: 56px;
  }
  .code-terminal {
    background: #0c121e;
    border: 2px solid var(--ink);
    border-radius: 8px;
    box-shadow: 4px 4px 0 var(--ink);
    overflow: hidden;
  }
  .terminal-bar {
    background: #151d2f;
    border-bottom: 1px solid #1e293b;
    padding: 10px 18px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .term-title {
    font-family: "IBM Plex Mono", monospace;
    font-size: 11px;
    letter-spacing: 0.1em;
    color: #94a3b8;
    text-transform: uppercase;
  }
  .term-copy-btn {
    background: #1e293b;
    border: 1px solid #475569;
    color: #f8fafc;
    font-family: "IBM Plex Mono", monospace;
    font-size: 11px;
    padding: 4px 10px;
    border-radius: 4px;
    cursor: pointer;
  }
