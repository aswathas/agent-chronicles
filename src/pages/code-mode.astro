---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import "../styles/chronicles.css";

const mcpConfigSnippet = `{
  "mcpServers": {
    "olxcars": {
      "command": "uvx",
      "args": ["--from", "git+https://github.com/aswathas/olx-car-search", "olxcars", "mcp"]
    }
  }
}`;
---

<Base
  title="Code Mode & MCP Servers — The Agent Chronicles"
  description="In-memory programmatic tool use and token-efficient MCP servers for AI agents."
>
  <Nav currentPath="/code-mode/" />

  <main class="s page-container">
    <header class="page-header">
      <div class="eyebrow">SYSTEM ARCHITECTURE · BENCHMARKS</div>
      <h1 class="page-title">Code Mode & MCP Servers</h1>
      <p class="page-lede">
        Why programmatic tool execution beats traditional JSON function calling. Paging, joining, and filtering in local RAM cuts context tax by <b>99.5%</b> at ₹0 infrastructure cost.
      </p>
    </header>

    <!-- Benchmark Highlight Banner -->
    <div class="metric-banner">
      <div class="metric-card">
        <span class="m-val bad">32,450</span>
        <span class="m-lbl">Tokens (Traditional MCP)</span>
        <span class="m-sub">3 pages of raw ad JSON dumped into context</span>
      </div>
      <div class="metric-arrow">➔</div>
      <div class="metric-card highlight">
        <span class="m-val good">142</span>
        <span class="m-lbl">Tokens (Native Code Mode)</span>
        <span class="m-sub">99.5% reduction · Filtered in memory</span>
      </div>
      <div class="metric-card">
        <span class="m-val">1.1s</span>
        <span class="m-lbl">Execution Latency</span>
        <span class="m-sub">Single turn vs 3 conversational hops (4.8s)</span>
      </div>
    </div>

    <!-- Featured System 1: olxcars -->
    <section class="system-section">
      <div class="system-header">
        <div class="sys-badge">DUAL-MODE TOOL · PUBLISHED</div>
        <h2>olxcars: Used Car Search for AI Agents</h2>
        <p>
          OLX India has no public API and aggressively blocks standard HTTP clients at the TLS ClientHello layer. <code>olxcars</code> ships a Chrome TLS handshake bypass, a fluent in-memory query builder, and a stdio MCP server.
        </p>
      </div>

      <div class="dual-columns">
        <div class="col-panel">
          <div class="panel-header">
            <h3>Mode A: Native Code Mode (Terminal Agents)</h3>
            <span class="p-tag">Claude Code · Antigravity · Cursor</span>
          </div>
          <p>
            When an agent has shell access, it executes Python directly. 60 ads are fetched and filtered in RAM in 1 second. Only the 3 selected cars enter LLM context.
          </p>
          <div class="code-box">
            <div class="code-title">Python SDK (In-Memory)</div>
            <pre><code>from olxcars import OlxQuery

cars = (
    OlxQuery("i10")
    .city("chennai")
    .automatic()
    .under(400000)
    .first_owner()
    .fetch(pages=2)
    .top(3)
)
print(cars.compact())</code></pre>
          </div>
          <div class="install-row">
            <span>Terminal Run:</span>
            <code class="copyable">olxcars run "OlxQuery('i10').city('chennai').automatic().top(3)"</code>
          </div>
        </div>

        <div class="col-panel">
          <div class="panel-header">
            <h3>Mode B: Stdio MCP Server (Chat Apps)</h3>
            <span class="p-tag">Claude Desktop · ChatGPT Apps</span>
          </div>
          <p>
            For locked-down desktop chat clients with no terminal access, <code>olxcars</code> provides a standard Model Context Protocol server exposing search, listing, and location tools.
          </p>
          <div class="code-box">
            <div class="code-title">claude_desktop_config.json</div>
            <pre><code>{mcpConfigSnippet}</code></pre>
          </div>
          <div class="install-row">
            <span>Plugin Install:</span>
            <code class="copyable">claude plugin install olxcars@olx-car-search</code>
          </div>
        </div>
      </div>

      <div class="bench-table-wrap">
        <h3>Measured Benchmarks across 60-Car Search</h3>
        <table class="bench-table">
          <thead>
            <tr>
              <th>Metric</th>
              <th>Traditional MCP (Tool Calling)</th>
              <th>CLI Table Mode</th>
              <th>Native Code Mode (In-Memory)</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><b>Context Bill</b></td>
              <td><span class="tag-red">32,450 tokens</span> (120 KB JSON)</td>
              <td>~820 tokens</td>
              <td><span class="tag-green">142 tokens</span> (99.5% reduction)</td>
            </tr>
            <tr>
              <td><b>Conversational Hops</b></td>
              <td>3 sequential turns</td>
              <td>1 command</td>
              <td>1 single turn</td>
            </tr>
            <tr>
              <td><b>Network Latency</b></td>
              <td>4.8s (3 HTTP + 3 LLM hops)</td>
              <td>1.4s</td>
              <td>1.1s (concurrent in-memory)</td>
            </tr>
            <tr>
              <td><b>Filter Logic</b></td>
              <td>Rigid (limited to tool schema)</td>
              <td>Fixed flags</td>
              <td>Arbitrary Python (custom scoring, ratios)</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- Featured System 2: TradeMCP -->
    <section class="system-section">
      <div class="system-header">
        <div class="sys-badge">EQUITIES MCP · 14 TOOLS</div>
        <h2>TradeMCP: Indian Equities Model Context Protocol</h2>
        <p>
          Free MCP server for Indian stock markets (NSE & BSE). Exposes 14 financial tools, 57 technical analysis indicators (RSI, MACD, Bollinger Bands), 54 fundamental ratios, and a full market screener. Zero API keys needed.
        </p>
      </div>

      <div class="trade-grid">
        <div class="trade-card">
          <h4>14 Specialized Tools</h4>
          <p>Real-time quotes, multi-timeframe historical candles, corporate actions, option chain analysis, and institutional holdings.</p>
        </div>
        <div class="trade-card">
          <h4>57 Technical Indicators</h4>
          <p>Native computation in Python for moving averages, momentum oscillators, volatility bands, and volume profiles.</p>
        </div>
        <div class="trade-card">
          <h4>NSE / BSE Screener</h4>
          <p>Query stocks matching programmatic filter formulas across market cap, P/E ratios, ROCE, and dividend yields.</p>
        </div>
      </div>

      <div class="install-bar">
        <span>One-command runner:</span>
        <code class="copyable">npx -y trademcp</code>
        <a href="https://github.com/aswathas/TradeMCP" target="_blank" rel="noopener" class="gh-link">View Repo ➔</a>
      </div>
    </section>

    <!-- Featured System 3: Instagram MCP -->
    <section class="system-section">
      <div class="system-header">
        <div class="sys-badge">SYSTEM PATCH · FORENSICS</div>
        <h2>Instagram MCP Server (Session Auth Fix)</h2>
        <p>
          Analysis and patch resolving the persistent password login crash in community Instagram MCP tools. Replaces brittle username/password handshakes with secure session cookies and adds direct read/write tools.
        </p>
      </div>
      <div class="install-bar">
        <span>Repo & Incident Logs:</span>
        <code class="copyable">https://github.com/aswathas/instagram-mcp-logs</code>
        <a href="https://github.com/aswathas/instagram-mcp-logs" target="_blank" rel="noopener" class="gh-link">View Patch ➔</a>
      </div>
    </section>
  </main>

  <Footer />
</Base>

<style>
  .page-container {
    padding-top: 48px;
  }
  .page-header {
    margin-bottom: 40px;
    border-bottom: 3px double var(--ink);
    padding-bottom: 24px;
  }
  .eyebrow {
    font-family: "IBM Plex Mono", monospace;
    font-size: 11px;
    letter-spacing: 0.16em;
    color: var(--red);
    text-transform: uppercase;
    margin-bottom: 8px;
  }
  .page-title {
    font-family: "Archivo Black", sans-serif;
    font-size: 2.8rem;
    line-height: 1;
    text-transform: uppercase;
    letter-spacing: -0.03em;
    margin-bottom: 16px;
  }
  .page-lede {
    font-size: 1.25rem;
    color: var(--grey);
    line-height: 1.5;
    max-width: 860px;
  }

  /* Metric Banner */
  .metric-banner {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 64px;
    flex-wrap: wrap;
  }
  .metric-card {
    flex: 1;
    min-width: 220px;
    background: var(--card);
    border: 2px solid var(--ink);
    padding: 24px;
  }
  .metric-card.highlight {
    background: var(--ink);
    color: var(--paper);
  }
  .metric-arrow {
    font-size: 28px;
    font-weight: bold;
    color: var(--red);
  }
  .m-val {
    display: block;
    font-family: "Archivo Black", sans-serif;
    font-size: 2.4rem;
    line-height: 1;
    margin-bottom: 8px;
  }
  .m-val.bad { color: var(--red); }
  .m-val.good { color: #10b981; }
  .m-lbl {
    display: block;
    font-family: "IBM Plex Mono", monospace;
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 4px;
  }
  .m-sub {
    font-size: 13px;
    color: var(--grey);
  }
  .metric-card.highlight .m-sub {
    color: rgba(239, 231, 216, 0.7);
  }

  /* Systems */
  .system-section {
    margin-bottom: 80px;
    border-top: 1px solid var(--ink);
    padding-top: 36px;
  }
  .sys-badge {
    display: inline-block;
    font-family: "IBM Plex Mono", monospace;
    font-size: 10px;
    letter-spacing: 0.14em;
    background: var(--red);
    color: #fff;
    padding: 3px 8px;
    margin-bottom: 12px;
  }
  .system-header h2 {
    font-family: "Archivo Black", sans-serif;
    font-size: 1.8rem;
    text-transform: uppercase;
    margin-bottom: 12px;
  }
  .system-header p {
    font-size: 1.1rem;
    color: var(--grey);
    max-width: 820px;
    margin-bottom: 32px;
  }

  /* Dual Columns */
  .dual-columns {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
    margin-bottom: 40px;
  }
  .col-panel {
    background: var(--card);
    border: 2px solid var(--ink);
    padding: 24px;
  }
  .panel-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 12px;
    flex-wrap: wrap;
    gap: 8px;
  }
  .panel-header h3 {
    font-family: "Archivo Black", sans-serif;
    font-size: 1.1rem;
    text-transform: uppercase;
  }
  .p-tag {
    font-family: "IBM Plex Mono", monospace;
    font-size: 10px;
    color: var(--grey);
  }
  .col-panel p {
    font-size: 14px;
    color: var(--grey);
    margin-bottom: 16px;
  }
  .code-box {
    background: var(--ink);
    color: var(--paper);
    padding: 16px;
    border-radius: 4px;
    margin-bottom: 16px;
  }
  .code-title {
    font-family: "IBM Plex Mono", monospace;
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--paper2);
    border-bottom: 1px solid rgba(255,255,255,0.2);
    padding-bottom: 6px;
    margin-bottom: 10px;
  }
  .code-box pre {
    overflow-x: auto;
    font-family: "IBM Plex Mono", monospace;
    font-size: 12px;
    line-height: 1.45;
  }
  .install-row {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    flex-wrap: wrap;
  }
  .copyable {
    background: rgba(20, 18, 16, 0.08);
    border: 1px solid var(--ink);
    padding: 4px 8px;
    font-family: "IBM Plex Mono", monospace;
    font-size: 12px;
    cursor: pointer;
  }
  .copyable:hover {
    background: var(--ink);
    color: var(--paper);
  }

  /* Table */
  .bench-table-wrap h3 {
    font-family: "Archivo Black", sans-serif;
    font-size: 1.2rem;
    text-transform: uppercase;
    margin-bottom: 12px;
  }
  .bench-table {
    width: 100%;
    border-collapse: collapse;
    background: var(--card);
    border: 2px solid var(--ink);
  }
  .bench-table th, .bench-table td {
    padding: 12px 16px;
    text-align: left;
    border: 1px solid var(--ink);
    font-size: 14px;
  }
  .bench-table th {
    font-family: "Archivo Black", sans-serif;
    text-transform: uppercase;
    font-size: 12px;
    background: var(--paper2);
  }
  .tag-red { color: var(--red); font-weight: bold; }
  .tag-green { color: #10b981; font-weight: bold; }

  /* Trade grid */
  .trade-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    margin-bottom: 24px;
  }
  .trade-card {
    background: var(--card);
    border: 2px solid var(--ink);
    padding: 20px;
  }
  .trade-card h4 {
    font-family: "Archivo Black", sans-serif;
    font-size: 1rem;
    text-transform: uppercase;
    margin-bottom: 8px;
  }
  .trade-card p {
    font-size: 14px;
    color: var(--grey);
  }
  .install-bar {
    display: flex;
    align-items: center;
    gap: 12px;
    background: var(--card);
    border: 2px solid var(--ink);
    padding: 14px 20px;
    flex-wrap: wrap;
  }
  .gh-link {
    margin-left: auto;
    font-family: "IBM Plex Mono", monospace;
    font-size: 12px;
    font-weight: bold;
    color: var(--red);
    text-decoration: none;
  }

  @media (max-width: 900px) {
    .dual-columns, .trade-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
