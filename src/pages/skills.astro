---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import "../styles/chronicles.css";
import catalog from "../data/catalog.json";

// Group catalog items by category
const rawBase = import.meta.env.BASE_URL || "/";
const base = rawBase.endsWith("/") ? rawBase : `${rawBase}/`;

const categories = Array.from(new Set(catalog.map((i) => i.category)));
const groupedSkills = categories.map((cat) => ({
  category: cat,
  items: catalog.filter((i) => i.category === cat),
}));
---

<Base
  title="Minted Skills & Tool Catalog — The Agent Chronicles"
  description="Tested, procedure-first agent skill catalog inspired by skill.sh, skill.fish, and mcpservers.org."
>
  <Nav currentPath="/skills/" />

  <main class="s page-container">
    <header class="page-header">
      <div class="eyebrow">AGENT CAPABILITY CATALOG · TESTED PROCEDURES · MODEL CARDS</div>
      <h1 class="page-title">Minted Skills &amp; Tools Catalog</h1>
      <p class="page-lede">
        Instructions and code modes designed for AI agents. Every item has its own dedicated page with verified evaluations, failure-mode forensics, model cards, interactive SVG architecture diagrams, and copyable one-line install snippets.
      </p>
    </header>

    <!-- Search / Filter Bar -->
    <div class="skills-filter-bar">
      <input
        type="search"
        id="skillSearch"
        placeholder="Filter 20 skills & tools by keyword (e.g. olx, chronicle, router, obsidian, audit)..."
        class="skill-search-input"
      />
    </div>

    <!-- Skills Grouped Sections -->
    {groupedSkills.map((group) => (
      <section class="skill-group-section">
        <div class="group-title-row">
          <h2>{group.category}</h2>
          <span class="group-count">{group.items.length} skills &amp; tools</span>
        </div>

        <div class="skills-stack">
          {group.items.map((skill) => (
            <div class="skill-entry" data-name={skill.name.toLowerCase()} data-desc={skill.tagline.toLowerCase()}>
              <div class="skill-main">
                <div class="skill-top">
                  <a href={`${base}skills/${skill.slug}/`} class="skill-name-link">
                    <h3 class="skill-name">{skill.name}</h3>
                  </a>
                  <span class="skill-pill">{skill.modelCard.type}</span>
                </div>
                <div class="skill-trigger">
                  <span class="lbl">TRIGGER:</span> {skill.trigger}
                </div>
                <p class="skill-desc">{skill.tagline}</p>

                <!-- Spec Pill Highlights -->
                <div class="spec-pills-row">
                  <span class="mini-spec-pill">Runtime: <b>{skill.modelCard.runtime}</b></span>
                  <span class="mini-spec-pill highlight">Proof: <b>{skill.evaluation.headlineMetric} {skill.evaluation.headlineSub}</b></span>
                </div>

                <div class="skill-footer">
                  <div class="install-block">
                    <span>Install:</span>
                    <code class="copyable" data-copy={skill.installCommand}>{skill.installCommand}</code>
                  </div>
                  <div class="card-links">
                    <a href={`${base}skills/${skill.slug}/`} class="detail-link">Model Card &amp; Proof ➔</a>
                    <a href={skill.repoUrl} target="_blank" rel="noopener" class="src-link">Source ↗</a>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </section>
    ))}
  </main>

  <Footer />

  <script>
    const searchInput = document.getElementById("skillSearch") as HTMLInputElement;
    if (searchInput) {
      searchInput.addEventListener("input", () => {
        const query = searchInput.value.toLowerCase().trim();
        document.querySelectorAll<HTMLElement>(".skill-entry").forEach((el) => {
          const name = el.dataset.name || "";
          const desc = el.dataset.desc || "";
          el.style.display = name.includes(query) || desc.includes(query) ? "block" : "none";
        });
      });
    }

    document.querySelectorAll<HTMLElement>(".copyable").forEach((code) => {
      code.title = "Click to copy";
      code.style.cursor = "pointer";
      code.addEventListener("click", () => {
        const text = code.dataset.copy || code.textContent || "";
        navigator.clipboard.writeText(text.trim()).then(() => {
          const orig = code.textContent;
          code.textContent = "✔ Copied!";
          setTimeout(() => { code.textContent = orig; }, 1500);
        });
      });
    });
  </script>
</Base>

<style>
  .page-container {
    padding-top: 48px;
    padding-bottom: 96px;
  }
  .page-header {
    margin-bottom: 36px;
    border-bottom: 3px double var(--ink);
    padding-bottom: 24px;
  }
  .eyebrow {
    font-family: "IBM Plex Mono", monospace;
    font-size: 11px;
    letter-spacing: 0.16em;
    color: var(--red);
    text-transform: uppercase;
    margin-bottom: 8px;
  }
  .page-title {
    font-family: "Archivo Black", sans-serif;
    font-size: 2.8rem;
    line-height: 1;
    text-transform: uppercase;
    letter-spacing: -0.03em;
    margin-bottom: 16px;
  }
  .page-lede {
    font-size: 1.25rem;
    color: var(--grey);
    line-height: 1.5;
    max-width: 860px;
  }

  .skills-filter-bar {
    margin-bottom: 40px;
  }
  .skill-search-input {
    width: 100%;
    padding: 14px 20px;
    background: var(--card);
    border: 2px solid var(--ink);
    font-family: "IBM Plex Mono", monospace;
    font-size: 14px;
    color: var(--ink);
    outline: none;
    box-shadow: 4px 4px 0 var(--ink);
  }
  .skill-search-input:focus {
    background: #fff;
    border-color: var(--red);
  }

  .skill-group-section {
    margin-bottom: 64px;
  }
  .group-title-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    border-bottom: 2px solid var(--ink);
    padding-bottom: 8px;
    margin-bottom: 20px;
  }
  .group-title-row h2 {
    font-family: "Archivo Black", sans-serif;
    font-size: 1.5rem;
    text-transform: uppercase;
  }
  .group-count {
    font-family: "IBM Plex Mono", monospace;
    font-size: 11px;
    color: var(--grey);
    text-transform: uppercase;
  }

  .skills-stack {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .skill-entry {
    background: var(--card);
    border: 2px solid var(--ink);
    box-shadow: 4px 4px 0 var(--ink);
    padding: 24px;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .skill-entry:hover {
    transform: translateY(-2px);
    box-shadow: 6px 6px 0 var(--ink);
  }

  .skill-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 10px;
    gap: 12px;
    flex-wrap: wrap;
  }
  .skill-name-link {
    text-decoration: none;
    color: inherit;
  }
  .skill-name-link:hover .skill-name {
    color: var(--red);
  }
  .skill-name {
    font-family: "Archivo Black", sans-serif;
    font-size: 1.4rem;
    text-transform: uppercase;
    letter-spacing: -0.01em;
  }
  .skill-pill {
    font-family: "IBM Plex Mono", monospace;
    font-size: 10px;
    letter-spacing: 0.1em;
    background: var(--paper2);
    color: var(--ink);
    padding: 3px 10px;
    border: 1px solid var(--ink);
    border-radius: 999px;
    text-transform: uppercase;
  }

  .skill-trigger {
    font-family: "IBM Plex Mono", monospace;
    font-size: 12px;
    color: var(--grey);
    background: var(--paper);
    padding: 8px 12px;
    border-left: 3px solid var(--red);
    margin-bottom: 12px;
    line-height: 1.4;
  }
  .skill-trigger .lbl {
    color: var(--red);
    font-weight: 700;
  }

  .skill-desc {
    font-size: 1.15rem;
    color: var(--ink);
    line-height: 1.45;
    margin-bottom: 14px;
  }

  .spec-pills-row {
    display: flex;
    gap: 10px;
    margin-bottom: 16px;
    flex-wrap: wrap;
  }
  .mini-spec-pill {
    font-family: "IBM Plex Mono", monospace;
    font-size: 11px;
    background: var(--paper);
    border: 1px solid var(--paper2);
    padding: 4px 8px;
    border-radius: 4px;
    color: var(--grey);
  }
  .mini-spec-pill b {
    color: var(--ink);
  }
  .mini-spec-pill.highlight {
    background: #f0fdf4;
    border-color: #86efac;
    color: #166534;
  }
  .mini-spec-pill.highlight b {
    color: #15803d;
  }

  .skill-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 1px dashed var(--paper2);
    padding-top: 14px;
    gap: 16px;
    flex-wrap: wrap;
  }
  .install-block {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: "IBM Plex Mono", monospace;
    font-size: 12px;
  }
  .install-block span {
    color: var(--grey);
    text-transform: uppercase;
    font-size: 11px;
  }
  .install-block code {
    background: #0c121e;
    color: #38bdf8;
    padding: 4px 10px;
    border-radius: 4px;
    border: 1px solid #1e293b;
    font-size: 12px;
    max-width: 500px;
    overflow-x: auto;
    white-space: nowrap;
  }
  .install-block code:hover {
    border-color: #38bdf8;
  }

  .card-links {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .detail-link {
    font-family: "IBM Plex Mono", monospace;
    font-size: 12px;
    color: #020617;
    background: #38bdf8;
    padding: 5px 12px;
    border-radius: 999px;
    text-decoration: none;
    font-weight: 600;
    transition: background 0.15s ease;
  }
  .detail-link:hover {
    background: #0284c7;
    color: #fff;
  }
  .src-link {
    font-family: "IBM Plex Mono", monospace;
    font-size: 12px;
    color: var(--ink);
    text-decoration: none;
    border-bottom: 1px solid var(--ink);
  }
  .src-link:hover {
    color: var(--red);
    border-color: var(--red);
  }
</style>
