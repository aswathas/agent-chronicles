---
import Base from "../layouts/Base.astro";
import data from "../data/projects.json";
import "../styles/chronicles.css";

const { profile, stats, chips, sections, mcp, ticker } = data;
// BASE_URL has no trailing slash, so join rather than concatenate
const asset = (p: string) => import.meta.env.BASE_URL.replace(/\/$/, "") + "/" + p;
const tickerItems = [...ticker, ...ticker];

const sigil = () => `
<svg viewBox="0 0 60 60" aria-hidden="true">
  <circle class="pulse" cx="30" cy="30" r="24"/>
  <circle class="ring" cx="30" cy="30" r="26"/>
  <g class="spid"><ellipse cx="30" cy="33" rx="7" ry="9"/><circle cx="30" cy="22" r="4.6"/></g>
  <g class="eye"><circle cx="27.6" cy="21.4" r="1.1"/><circle cx="32.4" cy="21.4" r="1.1"/></g>
  <g class="spid" stroke="var(--red)" stroke-width="2" stroke-linecap="round" fill="none">
    <path d="M23 29 L11 21 M23 34 L10 34 M23 38 L11 47 M37 29 L49 21 M37 34 L50 34 M37 38 L49 47"/>
  </g>
</svg>`;
---

<Base
  title={`${profile.name} — agent systems, skills & tools`}
  description={profile.work.replace(/<[^>]+>/g, "")}
>
  <a class="skip" href="#main">Skip to content</a>

  <!-- texture + combat layers -->
  <div class="benday" aria-hidden="true"></div>
  <!-- the perch: a figure clinging to the right edge, and the right-edge
       spider-sense trigger. A button, so it is focusable and announces. -->
  <button class="perch" id="perch" type="button" aria-label="Return to top of page">
    <svg viewBox="0 0 76 132" aria-hidden="true">
      <path class="thread" d="M38 0 L38 46" />
      <!-- legs gripping, folded -->
      <path class="limb" d="M32 44 C22 52 18 62 22 72" />
      <path class="limb" d="M44 44 C54 52 58 62 54 72" />
      <!-- torso -->
      <path class="body" d="M28 40 C22 54 22 72 28 86 L48 86 C54 72 54 54 48 40 Z" />
      <!-- mask + lenses -->
      <ellipse class="mask" cx="38" cy="27" rx="15" ry="17" />
      <path class="lens" d="M27 24 C31 20 35 20 38 24 C35 29 30 29 27 24 Z" />
      <path class="lens" d="M49 24 C45 20 41 20 38 24 C41 29 46 29 49 24 Z" />
      <!-- trailing legs -->
      <path class="limb" d="M30 84 C24 96 26 110 32 120" />
      <path class="limb" d="M46 84 C52 96 50 110 44 120" />
    </svg>
  </button>
  <!-- spidey-sense HUD: an instrument over the paper, not a redesign of it -->
  <div class="alarm" id="alarm" aria-hidden="true"></div>
  <div class="aberration" aria-hidden="true"></div>
  <div class="sense-corners" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
  <div class="sense-ring" id="senseRing" aria-hidden="true"></div>
  <div class="hotspot" id="hotA" aria-hidden="true"><i></i><i></i><i></i></div>
  <div class="hotspot" id="hotB" aria-hidden="true"><i></i><i></i><i></i></div>
  <div class="hotspot" id="hotC" aria-hidden="true"><i></i><i></i><i></i></div>

  <div class="telem tl">
    <div><span class="lbl">state</span> <b id="tState">idle</b></div>
    <div><span class="lbl">threat</span> <b id="tThreat">none</b></div>
  </div>
  <div class="telem tr">
    <div><span class="lbl">traj</span> <b id="tTraj">—</b></div>
    <div><span class="lbl">vel</span> <b id="tVel">0.0</b></div>
  </div>
  <div class="telem bl">
    <div><span class="lbl">arc</span> <b>360°</b></div>
    <div><span class="lbl">contacts</span> <b id="tCon">0</b></div>
  </div>
  <div class="telem br">
    <div><span class="lbl">t-impact</span> <b id="tTti">—</b></div>
    <div><span class="lbl">sig</span> <b id="tSig">0%</b></div>
  </div>
  <div class="alarm-readout" id="alarmReadout" role="status" aria-live="polite">Danger sensed</div>

  <svg id="websvg" aria-hidden="true"></svg>

  <!-- spider sense -->
  <div class="sense sense-l" id="senseL" aria-hidden="true"><div class="sigil" set:html={sigil()} /><div class="lbl">Spider&nbsp;Sense</div></div>
  <div class="sense sense-r" id="senseR" aria-hidden="true"><div class="sigil" set:html={sigil()} /><div class="lbl">Spider&nbsp;Sense</div></div>
  <div class="sense sense-t" id="senseT" aria-hidden="true"><div class="lbl">Spider&nbsp;Sense</div><div class="sigil" set:html={sigil()} /></div>
  <div class="sense sense-b" id="senseB" aria-hidden="true"><div class="lbl">Spider&nbsp;Sense</div><div class="sigil" set:html={sigil()} /></div>
  <div class="wash wash-l" id="washL" aria-hidden="true"></div>
  <div class="wash wash-r" id="washR" aria-hidden="true"></div>
  <div class="wash wash-t" id="washT" aria-hidden="true"></div>
  <div class="wash wash-b" id="washB" aria-hidden="true"></div>


  <!-- ticker -->
  <div class="ticker" aria-hidden="true">
    <div class="tk">
      {tickerItems.map((t, i) => <span>{i === 0 ? `<b>●</b> ${t}` : t}</span>)}
    </div>
  </div>

  <div class="s" id="main" role="main" tabindex="-1">
    <!-- masthead -->
    <div class="mast">
      <div class="mast-id">
        <img class="avatar" src={asset("img/profile.webp")} alt="" width="44" height="44" />
        <div>
        <b>Est. 2024</b>Published by {profile.name}<br>Agent Systems Desk
        </div>
      </div>
      <div>
        <b>Issue 0116 · 2026</b>Skills · CLI · MCP · Web3
        <div class="socials" style="justify-content:flex-end">
          {
            profile.socials.map((s) => (
              <a class="soc" href={s.url} target="_blank" rel="noopener">{s.label}</a>
            ))
          }
        </div>
      </div>
    </div>

    <!-- hero -->
    <div class="hero">
      <div class="webbg"><svg viewBox="0 0 400 400" id="webart"></svg></div>
      <img class="hero-avatar" src={asset("img/profile.webp")} alt="" width="96" height="96" />
      <div class="eyebrow">{profile.eyebrow}</div>
      <h1 class="name"><span class="w"><i>Aswath</i></span> <span class="w"><i>S</i></span></h1>
      <div class="work" set:html={profile.work} />
      <div class="meta">
        {stats.map((s) => <div><b>{s.value}</b><span>{s.label}</span></div>)}
    
      <nav class="filters" aria-label="Filter projects by kind">
        <button class="filter is-on" data-filter="all" aria-pressed="true">All</button>
        <button class="filter" data-filter="ai" aria-pressed="false">AI</button>
        <button class="filter" data-filter="mcp" aria-pressed="false">MCP</button>
        <button class="filter" data-filter="web3" aria-pressed="false">Web3</button>
        <button class="filter" data-filter="security" aria-pressed="false">Security</button>
        <button class="filter" data-filter="skills" aria-pressed="false">Skills</button>
        <button class="filter" data-filter="windows" aria-pressed="false">Windows</button>
        <button class="filter" data-filter="agents" aria-pressed="false">Agents</button>
        <button class="filter" data-filter="health" aria-pressed="false">Health</button>
      </nav>
      </div>
    </div>
    <div class="rt"></div>

    <!-- cover -->
    <div class="cover">
      <div class="cover-l">
        <div class="kick">By {profile.name} · Agent Systems</div>
        <div class="big">I build the<br />tools that<br /><em>teach agents</em><br />to work.</div>
        <p class="lede">
          Nine published skills, four terminal tools, three shipped apps, a Web3
          forensics suite, and one course. Everything here is something a model, an
          agent, or a terminal can actually use.
        </p>
        <div class="chips" style="margin-top:26px">
          {chips.map((c) => <a class="chip" href={c.href}>{c.label}</a>)}
        </div>
      </div>
      <div class="cover-r">
        <div class="burst"><b>9</b><span>Skills<br />published</span></div>
        <div style="font-family:'IBM Plex Mono',monospace;font-size:9px;letter-spacing:.16em;text-transform:uppercase;color:var(--grey);line-height:2">
          Vol. XXVI · No. 0116<br />Printed in the terminal<br />Est. 2024
        </div>
      </div>
    </div>

    <!-- sections -->
    {
      sections.map((sec) => (
        <section id={sec.id} class="rev">
          <div class="sech">
            <h2 class="mline"><span>{sec.title}</span></h2>
            <span class="bl">{sec.blurb}</span>
            <span class="ct">{sec.count}</span>
          </div>
          <div class="webrule"><svg viewBox="0 0 1200 30" preserveAspectRatio="none"></svg></div>

          {/* One container, one card. The card is a div, not an anchor: a card can
              carry two destinations (source + live), and nesting anchors is invalid.
              The title holds a stretched link that covers the whole card; the explicit
              pair sits above it so both destinations stay reachable. */}
          <div
            class:list={["grid", sec.id === "research" && "rlist", sec.collapsible && "is-collapsible"]}
            data-collapsible={sec.collapsible ? "true" : undefined}
          >
            {sec.items.map((it, ix) => (
              <div class="p-wrap" data-tags={(it.tags || []).join(",")}>
                <a
                  class:list={[
                    "p",
                    it.note && "note",
                    it.tint === "blue" && "blue",
                    it.tint === "red" && "red",
                    it.url && "linked",
                    sec.collapsible && ix >= 3 && "is-more",
                  ]}
                  href={it.url}
                  target="_blank"
                  rel="noopener"
                >
                  {it.tag && <span class="tag">{it.tag}</span>}
                  <h3>{it.name}</h3>
                  {it.meta && <div class="meta">{it.meta}</div>}
                  <p>{it.desc}</p>
                  {it.install && <code>{it.install}</code>}
                  {!it.install && it.code && <code>{it.code}</code>}
                </a>
                {it.live && (
                  <a class="card-live" href={it.live} target="_blank" rel="noopener">Live</a>
                )}
              </div>
            ))}
          </div>
        </section>
      ))
    }

    <!-- MCP -->
    <section class="rev">
      <div class="sech">
        <h2 class="mline"><span>{mcp.title}</span></h2>
        <span class="bl">{mcp.blurb}</span>
        <span class="ct">{mcp.count}</span>
      </div>
      <div class="next">
        {mcp.cells.map((c) => <div class:list={["cell", c.dark && "dark"]}><b>{c.h}</b><span>{c.p}</span></div>)}
      </div>
    </section>

    <footer>
      <span>{profile.name} · The Agent Chronicles</span>
      <span class="socials">
        {profile.socials.map((s) => <a class="soc" href={s.url} target="_blank" rel="noopener">{s.label}</a>)}
      </span>
    </footer>
  </div>

  <script src="../scripts/chronicles.ts"></script>
</Base>