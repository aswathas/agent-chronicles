---
import Base from "../layouts/Base.astro";
import data from "../data/projects.json";
import "../styles/global.css";

const { profile, stats, categories } = data;
const populated = categories.filter((c) => c.items.length > 0);
const totalProjects = categories.reduce((n, c) => n + c.items.length, 0);
---

<Base
  title={`${profile.name} — agentic systems, skills & tools`}
  description={profile.tagline}
>
  <main class="wrap">
    <!-- ── header ───────────────────────────────────────────── -->
    <header class="chrome" id="top">
      <div class="chrome-dots" aria-hidden="true">
        <span class="d d-r"></span><span class="d d-y"></span><span class="d d-g"></span>
      </div>
      <div class="chrome-title">{profile.handle} · agent systems</div>
    </header>

    <!-- ── hero ─────────────────────────────────────────────── -->
    <section class="hero">
      <h1 class="hero-title">
        <span class="prompt">▍</span>{profile.tagline}
      </h1>
      <p class="hero-sub">{profile.subline}</p>

      <ul class="stats" role="list">
        {
          stats.map((s) => (
            <li class="stat">
              <span class="stat-label">{s.label}</span>
              <span class="stat-value">{s.value}</span>
              <span class="stat-detail">{s.detail}</span>
            </li>
          ))
        }
      </ul>

      <nav class="quicklinks" aria-label="Primary">
        <a class="btn btn-primary" href={profile.github}>
          <span class="btn-prompt">$</span> github
        </a>
        <a class="btn" href={profile.skillsRepo}>
          <span class="btn-prompt">$</span> install a skill
        </a>
        <a class="btn btn-ghost" href="#work">
          <span class="btn-prompt">$</span> ls ~/work
        </a>
      </nav>
    </section>

    <!-- ── categories ───────────────────────────────────────── -->
    <section id="work" class="work">
      <h2 class="section-head">
        <span class="cmd">$</span> ls ~/work
      </h2>
      <p class="section-note">
        {totalProjects} projects across {populated.length} categories.
        Only the agentic work — not everything on the account.
      </p>

      <nav class="filters" aria-label="Filter by category">
        <button class="chip is-on" data-filter="all">all</button>
        {
          categories.map((c) => (
            <button class="chip" data-filter={c.id}>
              {c.label}
              <span class="chip-n">{c.items.length}</span>
            </button>
          ))
        }
      </nav>

      {
        categories.map((cat) => (
          <section class="cat" data-cat={cat.id}>
            <div class="cat-head">
              <h3 class="cat-name">
                <span class="cat-marker">▸</span> {cat.label}
              </h3>
              <p class="cat-blurb">{cat.blurb}</p>
            </div>

            {cat.items.length === 0 ? (
              <div class="empty">
                <span class="empty-caret">&gt;</span> {cat.empty}
              </div>
            ) : (
              <ul class="cards" role="list">
                {cat.items.map((item) => (
                  <li class="card">
                    <a href={item.url} class="card-link">
                      <div class="card-top">
                        <span class="card-name">{item.name}</span>
                        <span class="card-lang">{item.lang}</span>
                        {item.status && <span class="badge">{item.status}</span>}
                      </div>
                      <p class="card-desc">{item.desc}</p>
                      {item.install && (
                        <code class="card-install">
                          <span class="btn-prompt">$</span> {item.install}
                        </code>
                      )}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </section>
        ))
      }
    </section>

    <!-- ── footer ───────────────────────────────────────────── -->
    <footer class="foot">
      <p class="foot-line">
        Built with Astro. Content in <code>src/data/projects.json</code> — edit that, not the markup.
      </p>
      <p class="foot-line foot-dim">
        <a href={profile.github}>{profile.handle}</a> · {new Date().getFullYear()}
      </p>
    </footer>
  </main>

  <script>
    const chips = Array.from(document.querySelectorAll<HTMLElement>(".chip"));
    const cats = Array.from(document.querySelectorAll<HTMLElement>(".cat"));

    function apply(filter: string) {
      for (const c of cats) {
        const show = filter === "all" || c.dataset.cat === filter;
        c.hidden = !show;
      }
      for (const chip of chips) {
        chip.classList.toggle("is-on", chip.dataset.filter === filter);
      }
      if (filter !== "all") {
        const target = document.getElementById("work");
        if (target) target.scrollIntoView({ block: "start" });
      }
    }

    for (const chip of chips) {
      chip.addEventListener("click", () => apply(chip.dataset.filter ?? "all"));
    }
  </script>
</Base>

<style>
  /* ── chrome bar ─────────────────────────────────────────── */
  .chrome {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 14px;
    background: var(--bg-raised);
    border: 1px solid var(--border);
    border-radius: 8px 8px 0 0;
    border-bottom: none;
    font-size: 12px;
    color: var(--text-dim);
  }
  .chrome-dots {
    display: flex;
    gap: 6px;
  }
  .d {
    width: 11px;
    height: 11px;
    border-radius: 50%;
  }
  .d-r { background: #ff5f57; }
  .d-y { background: #febc2e; }
  .d-g { background: #28c840; }
  .chrome-title { letter-spacing: 0.02em; }

  /* ── hero ───────────────────────────────────────────────── */
  .hero {
    border: 1px solid var(--border);
    border-top: none;
    background:
      linear-gradient(180deg, rgba(74, 222, 128, 0.04), transparent 220px),
      var(--bg-raised);
    border-radius: 0 0 8px 8px;
    padding: 48px 32px 40px;
    margin-bottom: 72px;
  }
  .hero-title {
    font-size: clamp(22px, 4.5vw, 38px);
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: -0.02em;
  }
  .prompt {
    color: var(--accent);
    margin-right: 4px;
    animation: blink 1.1s steps(2, start) infinite;
  }
  @keyframes blink {
    to { opacity: 0; }
  }
  .hero-sub {
    color: var(--text-dim);
    margin-top: 12px;
    font-family: var(--sans);
    font-size: 15px;
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
    border-radius: 6px;
    overflow: hidden;
    margin: 32px 0;
    list-style: none;
  }
  .stat {
    background: var(--bg);
    padding: 14px 16px;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .stat-label {
    font-size: 11px;
    letter-spacing: 0.1em;
    color: var(--text-faint);
  }
  .stat-value {
    font-size: 26px;
    font-weight: 700;
    color: var(--accent);
    line-height: 1.1;
  }
  .stat-detail {
    font-size: 11px;
    color: var(--text-faint);
    font-family: var(--sans);
  }

  .quicklinks {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 9px 16px;
    border: 1px solid var(--border-bright);
    border-radius: 6px;
    background: var(--bg-inset);
    color: var(--text);
    font-size: 13px;
    transition: border-color 0.15s, background 0.15s, transform 0.15s;
  }
  .btn:hover {
    border-color: var(--accent);
    background: var(--accent-glow);
    transform: translateY(-1px);
  }
  .btn-primary {
    border-color: var(--accent-dim);
    color: var(--accent);
  }
  .btn-ghost {
    color: var(--text-dim);
  }
  .btn-prompt {
    color: var(--accent);
  }

  /* ── sections ───────────────────────────────────────────── */
  .section-head {
    font-size: 16px;
    color: var(--text);
  }
  .cmd {
    color: var(--accent);
    margin-right: 6px;
  }
  .section-note {
    color: var(--text-faint);
    font-size: 12px;
    margin: 6px 0 22px;
    font-family: var(--sans);
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 40px;
    position: sticky;
    top: 0;
    background: var(--bg);
    padding: 12px 0;
    z-index: 5;
    border-bottom: 1px solid var(--border);
  }
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 6px 13px;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: transparent;
    color: var(--text-dim);
    font-family: var(--mono);
    font-size: 12px;
    cursor: pointer;
    transition: all 0.15s;
  }
  .chip:hover {
    border-color: var(--border-bright);
    color: var(--text);
  }
  .chip.is-on {
    border-color: var(--accent-dim);
    background: var(--accent-glow);
    color: var(--accent);
  }
  .chip-n {
    font-size: 10px;
    color: var(--text-faint);
  }
  .chip.is-on .chip-n {
    color: var(--accent);
  }

  .cat {
    margin-bottom: 52px;
  }
  .cat-head {
    margin-bottom: 18px;
  }
  .cat-name {
    font-size: 14px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text);
  }
  .cat-marker {
    color: var(--accent);
  }
  .cat-blurb {
    color: var(--text-faint);
    font-size: 12.5px;
    font-family: var(--sans);
    margin-top: 4px;
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(330px, 1fr));
    gap: 10px;
    list-style: none;
  }
  .card {
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--bg-raised);
    transition: border-color 0.15s, background 0.15s;
  }
  .card:hover {
    border-color: var(--accent-dim);
    background: #1b222c;
  }
  .card-link {
    display: block;
    padding: 16px 18px;
  }
  .card-top {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 8px;
    flex-wrap: wrap;
  }
  .card-name {
    font-weight: 700;
    font-size: 14px;
  }
  .card-lang {
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--blue);
    border: 1px solid rgba(121, 192, 255, 0.3);
    border-radius: 3px;
    padding: 1px 6px;
  }
  .badge {
    font-size: 10px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--amber);
    border: 1px solid rgba(210, 153, 34, 0.35);
    border-radius: 3px;
    padding: 1px 6px;
  }
  .card-desc {
    color: var(--text-dim);
    font-size: 12.5px;
    font-family: var(--sans);
    line-height: 1.6;
  }
  .card-install {
    display: block;
    margin-top: 12px;
    padding: 8px 10px;
    background: var(--bg-inset);
    border: 1px solid var(--border);
    border-radius: 4px;
    font-size: 10.5px;
    line-height: 1.5;
    color: var(--text-dim);
    /* wrap instead of clip — a truncated install command is worse than useless */
    overflow-wrap: anywhere;
  }

  .empty {
    border: 1px dashed var(--border);
    border-radius: 6px;
    padding: 20px;
    color: var(--text-faint);
    font-size: 12.5px;
    font-family: var(--sans);
  }
  .empty-caret {
    color: var(--accent);
  }

  /* ── footer ─────────────────────────────────────────────── */
  .foot {
    border-top: 1px solid var(--border);
    padding: 26px 0 56px;
    margin-top: 20px;
  }
  .foot-line {
    font-size: 11.5px;
    color: var(--text-faint);
    font-family: var(--sans);
  }
  .foot-dim {
    margin-top: 6px;
  }
  .foot code {
    font-family: var(--mono);
    color: var(--text-dim);
  }

  @media (max-width: 640px) {
    .hero {
      padding: 32px 20px 30px;
    }
    .cards {
      grid-template-columns: 1fr;
    }
  }
</style>