---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import data from "../data/projects.json";
import "../styles/chronicles.css";

const { profile, stats, ticker } = data;
const rawBase = import.meta.env.BASE_URL || "/";
const base = rawBase.endsWith("/") ? rawBase : `${rawBase}/`;
const asset = (p: string) => base + p.replace(/^\//, "");
const tickerItems = [...ticker, ...ticker];

const pillars = [
  {
    num: "01",
    title: "Code Modes & MCP Servers",
    tag: "99.5% Token Reduction",
    desc: "In-memory programmatic execution harnesses and stdio MCP servers. Paging, joining, and filtering in RAM beats dumping 120 KB of raw JSON into context.",
    featured: "olxcars · TradeMCP · Instagram MCP",
    href: `${base}code-mode/`,
  },
  {
    num: "02",
    title: "Minted Skills Catalog",
    tag: "Tested Procedures",
    desc: "A procedure-first skill store inspired by skill.sh. Zero-ambiguity instructions, trigger conditions, and verified commands for Claude Code, Gemini, and Cursor.",
    featured: "aswath-thinking · aswath-first-principles · aswath-chronicle · aswath-token-guard",
    href: `${base}skills/`,
  },
  {
    num: "03",
    title: "Routers & Harnesses",
    tag: "Zero-Context Routing",
    desc: "Scale an agent to 3,000+ skills without burning permanent context window tokens. Plugin hook routers, outcome-driven learning, and cross-harness NTFS junctions.",
    featured: "aswath-capability · skill-router · capability-router · skillhub",
    href: `${base}routers/`,
  },
  {
    num: "04",
    title: "AI Systems Research",
    tag: "Empirical Benchmarks",
    desc: "Rigorous benchmarks on LLM context tax, TLS ClientHello edge fingerprinting, and 298-case hierarchical capability router accuracy.",
    featured: "The Token Tax Study · TLS Bypass Forensics · 298-Case Intent Benchmark",
    href: `${base}research/`,
  },
  {
    num: "05",
    title: "Workflows & Swarms",
    tag: "Multi-Agent Coordination",
    desc: "Eliminate self-confirmation bias and agent hallucinations. Parallel reviewer swarms with 7 adversarial personas, doubt-driven loops, and token guardrails.",
    featured: "EGM Reviewer Swarms · Doubt-Driven Development · aswath-talk",
    href: `${base}workflows/`,
  },
];
---

<Base
  title={`${profile.name} — The Agent Chronicles`}
  description={profile.work.replace(/<[^>]+>/g, "")}
>
  <Nav currentPath="/" />

  <!-- texture layers -->
  <div class="benday" aria-hidden="true"></div>

  <!-- ticker -->
  <div class="ticker" aria-hidden="true">
    <div class="tk">
      {tickerItems.map((t, i) => <span>{i === 0 ? `<b>●</b> ${t}` : t}</span>)}
    </div>
  </div>

  <div class="s" id="main" role="main">
    <!-- masthead -->
    <div class="mast">
      <div class="mast-id">
        <img class="avatar" src={asset("img/profile.webp")} alt="" width="44" height="44" />
        <div>
          <b>Est. 2024</b>Published by {profile.name}<br>Agent Systems Desk
        </div>
      </div>
      <div>
        <b>Issue 0116 · 2026</b>Code Modes · Skills · Routers · Swarms
        <div class="socials" style="justify-content:flex-end">
          {profile.socials.map((s) => (
            <a class="soc" href={s.url} target="_blank" rel="noopener">{s.label}</a>
          ))}
        </div>
      </div>
    </div>

    <!-- hero -->
    <div class="hero">
      <div class="webbg"><svg viewBox="0 0 400 400" id="webart"></svg></div>
      <img class="hero-avatar" src={asset("img/profile.webp")} alt="" width="96" height="96" />
      <div class="eyebrow">{profile.eyebrow}</div>
      <h1 class="name"><span class="w"><i>Aswath</i></span> <span class="w"><i>S</i></span></h1>
      <div class="work" set:html={profile.work} />
      <div class="meta">
        {stats.map((s) => <div><b>{s.value}</b><span>{s.label}</span></div>)}
      </div>
    </div>

    <div class="rt"></div>

    <!-- cover section -->
    <div class="cover">
      <div class="cover-l">
        <div class="kick">By {profile.name} · Agent Systems Desk</div>
        <div class="big">I build the<br />tools that<br /><em>teach agents</em><br />to work.</div>
        <p class="lede">
          Ten minted skills, dual-mode search tools, zero-context capability routers, multi-agent reviewer swarms, and empirical systems research. Everything here is tested, MIT-licensed, and built for real terminal agents.
        </p>
      </div>
      <div class="cover-r">
        <div class="burst"><b>99.5%</b><span>Token Save<br />Code Mode</span></div>
        <div style="font-family:'IBM Plex Mono',monospace;font-size:9px;letter-spacing:.16em;text-transform:uppercase;color:var(--grey);line-height:2">
          Vol. XXVI · No. 0116<br />Pure AI Engineering<br />Est. 2024
        </div>
      </div>
    </div>

    <!-- Glimpse: The Five Core Pillars (Multi-page Hub) -->
    <section class="pillars-section">
      <div class="sech">
        <h2 class="mline"><span>System Architecture & Works</span></h2>
        <span class="bl">explore dedicated deep-dive sections</span>
        <span class="ct">05 core pillars</span>
      </div>

      <div class="pillars-grid">
        {pillars.map((pillar) => (
          <a href={pillar.href} class="pillar-card">
            <div class="p-top">
              <span class="p-num">{pillar.num}</span>
              <span class="p-tag">{pillar.tag}</span>
            </div>
            <h3 class="p-title">{pillar.title}</h3>
            <p class="p-desc">{pillar.desc}</p>
            <div class="p-feat">
              <span class="p-feat-lbl">Featured:</span>
              <span>{pillar.featured}</span>
            </div>
            <div class="p-cta">Explore Section ➔</div>
          </a>
        ))}
      </div>
    </section>

    <!-- About & Engineering Philosophy Section -->
    <section class="philosophy-section">
      <div class="sech">
        <h2 class="mline"><span>Engineering Philosophy</span></h2>
        <span class="bl">how we build AI tools</span>
      </div>
      <div class="philo-grid">
        <div class="philo-box">
          <h4>Zero Context Inflation</h4>
          <p>We reject dumping megabytes of unparsed JSON or 50 static tool definitions into LLM context. Programmatic tool use (Code Mode) processes arrays in memory and passes only signal into working memory.</p>
        </div>
        <div class="philo-box">
          <h4>Adversarial Verification</h4>
          <p>A single agent reviewing its own output hallucinates. We mandate independent subagent swarms with hostile and skeptical review personas before any architecture or spec is approved.</p>
        </div>
        <div class="philo-box">
          <h4>₹0 Infra Discipline</h4>
          <p>Real protocol understanding solves problems that paid third-party proxies hide. We write TLS-level Chrome handshakes and stdio bridges that run 100% locally with zero subscription cost.</p>
        </div>
      </div>
    </section>
  </div>

  <Footer />

  <script src="../scripts/chronicles.ts"></script>
</Base>

<style>
  .pillars-section {
    margin-top: 64px;
    margin-bottom: 80px;
  }
  .pillars-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
  }
  .pillar-card {
    background: var(--card);
    border: 2px solid var(--ink);
    padding: 32px;
    text-decoration: none;
    color: var(--ink);
    display: flex;
    flex-direction: column;
    transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
  }
  .pillar-card:hover {
    transform: translateY(-3px);
    box-shadow: 6px 6px 0 var(--ink);
    background: #fff;
  }
  .p-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 16px;
  }
  .p-num {
    font-family: "Archivo Black", sans-serif;
    font-size: 1.4rem;
    color: var(--red);
  }
  .p-tag {
    font-family: "IBM Plex Mono", monospace;
    font-size: 10px;
    letter-spacing: 0.1em;
    background: var(--paper2);
    border: 1px solid var(--ink);
    padding: 3px 8px;
    text-transform: uppercase;
  }
  .p-title {
    font-family: "Archivo Black", sans-serif;
    font-size: 1.6rem;
    text-transform: uppercase;
    line-height: 1.1;
    margin-bottom: 12px;
  }
  .p-desc {
    font-size: 15px;
    color: var(--grey);
    line-height: 1.5;
    margin-bottom: 24px;
  }
  .p-feat {
    margin-top: auto;
    font-family: "IBM Plex Mono", monospace;
    font-size: 11px;
    background: rgba(20, 18, 16, 0.05);
    padding: 8px 12px;
    border-left: 2px solid var(--ink);
    margin-bottom: 16px;
  }
  .p-feat-lbl {
    font-weight: bold;
    color: var(--ink);
    display: block;
    margin-bottom: 2px;
  }
  .p-cta {
    font-family: "IBM Plex Mono", monospace;
    font-size: 12px;
    font-weight: bold;
    color: var(--red);
    text-transform: uppercase;
  }

  /* Philosophy */
  .philosophy-section {
    margin-bottom: 80px;
  }
  .philo-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }
  .philo-box {
    background: var(--card);
    border: 2px solid var(--ink);
    padding: 24px;
  }
  .philo-box h4 {
    font-family: "Archivo Black", sans-serif;
    font-size: 1.1rem;
    text-transform: uppercase;
    margin-bottom: 10px;
    color: var(--red);
  }
  .philo-box p {
    font-size: 14px;
    line-height: 1.5;
    color: var(--grey);
  }

  @media (max-width: 900px) {
    .pillars-grid, .philo-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
